--- a/etc/nginx/sites-available/xpertapply-staging
+++ b/etc/nginx/sites-available/xpertapply-staging
@@ -6,2 +6,4 @@
     server_name staging.xpertapply.com api-staging.xpertapply.com;
+
+    add_header X-Robots-Tag "noindex, nofollow" always;
 
@@ -21,2 +23,10 @@
     server_name staging.xpertapply.com;
+
+    add_header X-Robots-Tag "noindex, nofollow" always;
+
+    # Staging must not advertise itself: keep robots.txt and sitemap.xml as 404 (as the current build does) so crawlers
+    # can still fetch pages and see the noindex header. An add_header inside a location REPLACES the inherited ones,
+    # so the header is repeated here.
+    location = /robots.txt  { add_header X-Robots-Tag "noindex, nofollow" always; return 404; }
+    location = /sitemap.xml { add_header X-Robots-Tag "noindex, nofollow" always; return 404; }
 
@@ -46,2 +56,4 @@
 
+    add_header X-Robots-Tag "noindex, nofollow" always;
+
     ssl_certificate /etc/letsencrypt/live/xpertapply-staging/fullchain.pem;
