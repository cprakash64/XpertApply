{
  "manifest_version": 3,
  "name": "EZJobFind — Assisted Apply",
  "short_name": "EZJobFind",
  "version": "0.2.0",
  "description": "User-controlled application copilot. Fills employer forms with your verified EZJobFind data — you always review and submit yourself.",
  "permissions": ["sidePanel", "storage", "scripting", "tabs"],
  "optional_permissions": ["webNavigation"],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open EZJobFind Assisted Apply" },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "https://app.jobpilot.ai/*",
        "https://ezjobfind.com/*",
        "https://www.ezjobfind.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "exclude_matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "https://app.jobpilot.ai/*",
        "https://ezjobfind.com/*",
        "https://www.ezjobfind.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
