{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["chrome", "vitest/globals"],
    "verbatimModuleSyntax": false,
    "noEmit": true
  },
  "include": ["src", "build.mjs"],
  // These tests assert against files on disk (the generated manifest, and the
  // source itself for the self-exclusion / credential-safety invariants) and
  // therefore need Node built-ins. Adding "node" to `types` globally would let
  // browser code reach for `process`/`fs` without a type error, so the
  // Node-using tests are excluded from the browser typecheck instead. Vitest
  // still runs them.
  "exclude": [
    "src/__tests__/generated_manifest.test.ts",
    "src/__tests__/self_exclusion_and_credentials.test.ts"
  ]
}
