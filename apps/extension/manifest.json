{
  "manifest_version": 3,
  "name": "XpertApply — Assisted Apply",
  "short_name": "XpertApply",
  "version": "0.2.0",
  "description": "AI-powered job application autofill and career copilot by XpertApply. You always review and submit every application yourself.",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs"
  ],
  "optional_permissions": [
    "webNavigation"
  ],
  "host_permissions": [
    "https://api.xpertapply.com/*",
    "https://xpertapply.com/*",
    "https://www.xpertapply.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://xpertapply.com/*",
      "https://www.xpertapply.com/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open XpertApply Assisted Apply"
  },
  "content_scripts": [
    {
      "matches": [
        "https://xpertapply.com/*",
        "https://www.xpertapply.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
