# XpertApply STAGING environment template. PLACEHOLDERS ONLY: never put real values in this file.
#
# Create the real file with:   infra/staging/staging-compose.sh init-env
# which writes infra/staging/.env.staging (mode 600, git-ignored) with freshly generated random secrets,
# and refuses to overwrite an existing file. Then set the two values it cannot know: EXTENSION_ALLOWED_IDS
# and (optionally) OPENAI_API_KEY. The wrapper refuses to run while any REPLACE_ME remains.
#
# Never copy a value from the production .env. The wrapper compares hashes of the secrets against the
# production .env when it can read it and stops on any match (it never prints either value).

# --- Environment ---------------------------------------------------------------------------------------
# `staging` is treated as production-strict by app.core.config_validation (known-weak secrets refused).
APP_ENV=staging
STAGING_API_HOST=api-staging.xpertapply.com
STAGING_WEB_HOST=staging.xpertapply.com
STAGING_API_PORT=8021
STAGING_WEB_PORT=3001

# --- Secrets (generated by init-env; all must be staging-only) -----------------------------------------
# Signs website tokens AND extension tokens. Independent from production, at least 32 random characters.
SECRET_KEY=REPLACE_ME
POSTGRES_USER=xa_staging
POSTGRES_DB=xpertapply_staging
POSTGRES_PASSWORD=REPLACE_ME
REDIS_PASSWORD=REPLACE_ME
WORKDAY_CREDENTIALS_ENCRYPTION_KEY=REPLACE_ME
PEOPLE_DATA_ENCRYPTION_KEY=REPLACE_ME
DEMOGRAPHICS_ENCRYPTION_KEY=

# --- Extension authentication --------------------------------------------------------------------------
# Exact allowlist of test extension ids (32 characters, a-p), as a JSON list. No wildcard, no default.
# Find the id of the unpacked build you are testing at chrome://extensions, then confirm that
# chrome.identity.getRedirectURL() inside that build equals https://<id>.chromiumapp.org/xpertapply.
# Token issuer/audience are fixed in code (iss=xpertapply-api, aud=xpertapply-extension): not configurable.
EXTENSION_ALLOWED_IDS=["REPLACE_ME"]

# --- Browser origins -----------------------------------------------------------------------------------
CORS_ORIGINS=["https://staging.xpertapply.com"]

# --- AI and external providers -------------------------------------------------------------------------
# STAGING_AI_MODE=disabled: OPENAI_API_KEY must stay empty; the API degrades safely (no tailored documents).
# STAGING_AI_MODE=capped:   set OPENAI_API_KEY to a SEPARATE staging-only key whose hard monthly spend limit
#                           is configured at the provider, and record that limit in STAGING_AI_CAP_NOTE.
STAGING_AI_MODE=disabled
OPENAI_API_KEY=
STAGING_AI_CAP_NOTE=
# Fixed off by compose.staging.yml (not variables): job-board ingestion, people discovery providers, AI
# outreach, Google OAuth. Password-recovery email stays disabled (EMAIL_BACKEND is not set here).

# --- Work-email discovery (OFF by default) ---------------------------------------------------------------
# Enabling it needs ALL of the following together; staging_guard.py refuses a partial or uncapped setup.
#   PEOPLE_EMAIL_DISCOVERY_ENABLED=true, a staging-only HUNTER_API_KEY (or Hunter's documented `test-api-key`
#   for dummy responses), PEOPLE_RECOMMENDATIONS_ENABLED=true, PEOPLE_ROLLOUT_MODE=internal,
#   PEOPLE_INTERNAL_EMAILS=<1-3 tester emails, comma separated>, and non-zero caps (0 means UNLIMITED).
# A different key on the same Hunter account still spends the SAME shared credit pool: the caps below are the
# only spend control. Never copy the production key here.
PEOPLE_EMAIL_DISCOVERY_ENABLED=false
HUNTER_API_KEY=
PEOPLE_RECOMMENDATIONS_ENABLED=false
PEOPLE_ROLLOUT_MODE=disabled
PEOPLE_INTERNAL_EMAILS=
PEOPLE_EMAIL_DAILY_CREDIT_BUDGET=4
PEOPLE_EMAIL_PER_USER_DAILY_LIMIT=4
PEOPLE_EMAIL_RATE_LIMIT_PER_HOUR=2

# --- Background jobs and logging -----------------------------------------------------------------------
# API only by default. Start worker/scheduler explicitly with `up --with-workers`; they are not needed for
# the XA-CORE1 checks (direct drafts prepare documents in-process, once).
# Logs go to the container's stdout (`staging-compose.sh logs`); the app redacts bearer tokens and secrets.

# --- Backups -------------------------------------------------------------------------------------------
# Outside the repository, outside any Docker volume. Staging data only.
STAGING_BACKUP_DIR=/home/luna/staging-backups
